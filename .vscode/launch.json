{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug TS File",
      "program": "${workspaceFolder}/ump_merge.ts",
      "args": ["${input:targetFolder}"],
      "console": "internalConsole",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "inputs": [
    {
      "id": "targetFolder",
      "type": "promptString",
      "description": "フォルダパスを入力してください",
      "default": "./"
    }
  ]
}